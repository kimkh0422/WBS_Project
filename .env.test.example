# npm run db:setup-new 가 .env.new 를 읽어 자동 생성하는 파일입니다.
# 수동 편집 시: npm run dev:test 로 이 설정을 사용합니다.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

VITE_BILLING_PLAN=free
VITE_REALTIME_ENABLED=false
