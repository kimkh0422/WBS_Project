# 로컬 실행: 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# Supabase 미설정 시 콘솔에 경고가 나오며, 로컬/메모리 모드로 동작합니다.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase: PostgreSQL 클라우드 DB 연동
# Supabase 대시보드 (https://supabase.com) > Project Settings > API 에서 확인
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# (선택) 쉼표로 구분해 숨길 메인 뷰 id (dashboard, table, gantt, …). 투입현황(allocation)은 코드상 기본 숨김입니다.
# VITE_HIDDEN_VIEWS="mindmap,kanban"

# (선택) true/1/yes 이면 표·간트·칸반·프로젝트 관리·마인드맵을 숨기고 대시보드만「프로젝트 현황」탭으로 둡니다(읽기 위주 배포).
# VITE_PROJECT_STATUS_ONLY="true"

# (선택) 요금제: paid(기본) | free — free면 Presence·셀 포커스·설명 실시간 공동편집 등 Realtime 최소화
# VITE_BILLING_PLAN="free"

# (선택) Realtime WebSocket·브로드캐스트 전반 비활성화(false). 무료 플랜과 동일 효과
# VITE_REALTIME_ENABLED="false"

# (선택) 마이그레이션 CLI 실행 시 사용. Project Settings > Database > Connection string에서 비밀번호 확인
# SUPABASE_DB_PASSWORD="YOUR_DB_PASSWORD"
