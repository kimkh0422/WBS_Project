{
  "name": "wbs-mg",
  "private": true,
  "version": "0.6.33",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "node scripts/update-release.mjs patch",
    "version:minor": "node scripts/update-release.mjs minor",
    "version:major": "node scripts/update-release.mjs major",
    "release": "node scripts/update-release.mjs patch",
    "postinstall": "simple-git-hooks",
    "db:migrate-profiles": "node scripts/run-profiles-migration.mjs",
    "db:open-migration": "node scripts/open-migration-in-browser.mjs",
    "db:fix-profiles-rls": "node scripts/open-fix-migration.mjs",
    "db:fix-rls": "node scripts/run-rls-fix.mjs",
    "db:fix-rls-open": "node scripts/open-rls-fix.mjs",
    "db:grant-visits": "node scripts/run-visit-grants.mjs",
    "db:grant-visits-open": "node scripts/open-visit-grants-in-browser.mjs",
    "db:visits-setup-open": "node scripts/open-visits-setup-in-browser.mjs",
    "db:report-fields-open": "node scripts/open-report-fields-migration.mjs",
    "db:share-profiles-open": "node scripts/open-share-profiles-migration.mjs",
    "supabase:deploy-functions": "supabase functions deploy admin-delete-user",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@ag-grid-community/styles": "^32.3.9",
